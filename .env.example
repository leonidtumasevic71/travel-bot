# Вставьте НОВЫЙ токен, полученный после отзыва старого через @BotFather
BOT_TOKEN=PASTE_NEW_TOKEN_HERE

# Числовой chat_id личного аккаунта менеджера, полученный через /id в этом боте.
# Менеджер @juuusmi должен сначала открыть бота и отправить /start, затем /id.
MANAGER_CHAT_ID=

# Username менеджера для кнопки прямого перехода клиента в личный Telegram-чат. Без @.
MANAGER_USERNAME=juuusmi

BRAND_NAME=ANYWAY
# Укажите реальную страницу политики конфиденциальности, если она опубликована.
PRIVACY_POLICY_URL=

DATABASE_PATH=data/applications.db
WELCOME_IMAGE=welcome.jpg
REMINDER_AFTER_MINUTES=60
